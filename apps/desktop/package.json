{
  "name": "bolt-ai-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BOLT AI synthetic analysis desktop prototype",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env BOLT_DEV=1 electron .\"",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "start": "electron .",
    "verify:source": "node --test electron/navigation.test.cjs && node --check electron/main.cjs",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fun.cadacrew.bolt",
    "productName": "BOLT AI",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/navigation.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "npmRebuild": false
  }
}
